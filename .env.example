# Copie para .env.local (não versionado) e preencha com os dados do app Web do projeto DEV
# (Firebase Console → Configurações do projeto → Seus apps → Configuração do SDK).
# Estes valores são públicos (vão para o navegador). Segredos NUNCA usam o prefixo VITE_.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# true = Auth e Firestore nos emuladores locais (npm run emuladores). Nunca use na Vercel.
VITE_USAR_EMULADORES=false
