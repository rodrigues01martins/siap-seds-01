rules_version = '2';

// Regras do Firestore — SIAP SEDS/GO 2026.
// O cliente NUNCA escreve: toda escrita passa pela /api (firebase-admin ignora estas regras).
// Leitura conforme o cadastro do usuário em usuarios/{uid} (perfil admin ou presidente, ativo), gravado pela
// /api. Admin e presidente leem tudo. Cadastro do modelo anterior (sem perfil) não lê nada; o administrador
// antigo (admin: true, sem o campo perfil) continua administrador.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    function cadastro() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function ativo() {
      return logado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && cadastro().get('ativo', true) != false;
    }

    // Perfil válido: o campo perfil (admin ou presidente) ou, sem ele, o administrador antigo (admin: true).
    function temPerfil(c) {
      return ('perfil' in c && c.perfil in ['admin', 'presidente'])
        || (!('perfil' in c) && c.get('admin', false) == true);
    }

    // Lê os dados do app: conta ativa com perfil admin ou presidente.
    function leitor() {
      return ativo() && temPerfil(cadastro());
    }

    // Matriz de avaliação: qualquer usuário autenticado.
    match /matrizes/{matrizId} {
      allow read: if logado();
      allow write: if false;
    }

    // Chamamentos e tudo abaixo (propostas, avaliações, sessões...).
    match /chamamentos/{documento=**} {
      allow read: if leitor();
      allow write: if false;
    }

    match /oscs/{oscId} {
      allow read: if leitor();
      allow write: if false;
    }

    // Histórico de alterações: admin e presidente (os dois fazem tudo no sistema).
    match /auditoria/{eventoId} {
      allow read: if leitor();
      allow write: if false;
    }

    // Cadastro do usuário: o próprio (o app lê o seu acesso) e os leitores (tela Usuários).
    match /usuarios/{uid} {
      allow read: if logado() && (request.auth.uid == uid || leitor());
      allow write: if false;
    }

    // Qualquer outro caminho: negado por padrão (nenhuma regra o libera).
  }
}
