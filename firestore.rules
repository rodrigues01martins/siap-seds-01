rules_version = '2';

// Regras do Firestore — SIAP SEDS/GO 2026.
// O cliente NUNCA escreve: toda escrita passa pela /api (firebase-admin ignora estas regras).
// Leitura conforme o custom claim "perfil" do ID token.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    function perfil() {
      return request.auth.token.get('perfil', '');
    }

    function temPerfil(permitidos) {
      return logado() && perfil() in permitidos;
    }

    // Matriz de avaliação: qualquer usuário autenticado.
    match /matrizes/{matrizId} {
      allow read: if logado();
      allow write: if false;
    }

    // Chamamentos e tudo abaixo (propostas, avaliações...): Comissão, admin e controle (só leitura).
    match /chamamentos/{documento=**} {
      allow read: if temPerfil(['admin', 'presidente', 'relator', 'membro', 'controle']);
      allow write: if false;
    }

    match /oscs/{oscId} {
      allow read: if temPerfil(['admin', 'presidente', 'relator', 'membro', 'controle']);
      allow write: if false;
    }

    // Trilha de auditoria: gestão e controle.
    match /auditoria/{eventoId} {
      allow read: if temPerfil(['admin', 'presidente', 'controle']);
      allow write: if false;
    }

    // Cadastro do usuário: o próprio, admin, e presidente/relator (listam a Comissão na sessão).
    match /usuarios/{uid} {
      allow read: if logado() && (request.auth.uid == uid || temPerfil(['admin', 'presidente', 'relator']));
      allow write: if false;
    }

    // Qualquer outro caminho: negado por padrão (nenhuma regra o libera).
  }
}
