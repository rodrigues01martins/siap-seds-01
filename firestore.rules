rules_version = '2';

// Regras do Firestore — SIAP SEDS/GO 2026.
// O cliente NUNCA escreve: toda escrita passa pela /api (firebase-admin ignora estas regras).
// Leitura conforme o cadastro do usuário em usuarios/{uid} (admin, permissoes, ativo), gravado pela /api.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    function cadastro() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function ativo() {
      return logado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && cadastro().get('ativo', true) != false;
    }

    function administrador() {
      return ativo() && cadastro().get('admin', false) == true;
    }

    // Lê os dados do app: conta ativa, administradora ou com ao menos uma permissão.
    function leitor() {
      return ativo() && (cadastro().get('admin', false) == true || cadastro().get('permissoes', []).size() > 0);
    }

    // Matriz de avaliação: qualquer usuário autenticado.
    match /matrizes/{matrizId} {
      allow read: if logado();
      allow write: if false;
    }

    // Chamamentos e tudo abaixo (propostas, avaliações, sessões...).
    match /chamamentos/{documento=**} {
      allow read: if leitor();
      allow write: if false;
    }

    match /oscs/{oscId} {
      allow read: if leitor();
      allow write: if false;
    }

    // Histórico de alterações: só o administrador.
    match /auditoria/{eventoId} {
      allow read: if administrador();
      allow write: if false;
    }

    // Cadastro do usuário: o próprio (o app lê o seu acesso) e os leitores (listam a Comissão na sessão).
    match /usuarios/{uid} {
      allow read: if logado() && (request.auth.uid == uid || leitor());
      allow write: if false;
    }

    // Qualquer outro caminho: negado por padrão (nenhuma regra o libera).
  }
}
